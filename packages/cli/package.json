{
  "name": "@subzero/cli",
  "version": "0.1.0",
  "description": "SubZero CLI - Modular Next.js Application Generator",
  "main": "dist/index.js",
  "bin": {
    "subzero-cli": "dist/bin/subzero-cli.js",
    "subzero": "dist/bin/subzero-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "cli",
    "nextjs",
    "generator",
    "modular",
    "typescript",
    "supabase"
  ],
  "author": "SubZero Team",
  "license": "MIT",
  "dependencies": {
    "@subzero/shared": "workspace:*",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^9.2.11",
    "fs-extra": "^11.1.1",
    "glob": "^10.3.4",
    "handlebars": "^4.7.8",
    "ora": "^5.4.1",
    "semver": "^7.5.4",
    "update-notifier": "^6.0.2",
    "validate-npm-package-name": "^5.0.0",
    "yaml": "^2.3.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.2",
    "@types/glob": "^8.1.0",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.8.0",
    "@types/semver": "^7.5.3",
    "@types/update-notifier": "^6.0.4",
    "@types/validate-npm-package-name": "^4.0.0",
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ]
} 